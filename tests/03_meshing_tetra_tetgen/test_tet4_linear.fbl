# ==============================================================================
# Test: 03_meshing_tetra_tetgen / test_tet4_linear.fbl
# Description: Linear 4-node Tetrahedral (te4 / C3D4) mesh via TetGen from tria skin
# ==============================================================================

# 1. 3D Prismatic Volume Geometry
pnt p1  0.0  0.0  0.0
pnt p2 20.0  0.0  0.0
pnt p3 20.0 20.0  0.0
pnt p4  0.0 20.0  0.0

pnt p5  0.0  0.0 20.0
pnt p6 20.0  0.0 20.0
pnt p7 20.0 20.0 20.0
pnt p8  0.0 20.0 20.0

line l1 p1 p2 4
line l2 p2 p3 4
line l3 p3 p4 4
line l4 p4 p1 4

line l5 p5 p6 4
line l6 p6 p7 4
line l7 p7 p8 4
line l8 p8 p5 4

line l9  p1 p5 4
line l10 p2 p6 4
line l11 p3 p7 4
line l12 p4 p8 4

gsur s_bot + BLEND + l1 + l2 + l3 + l4
gsur s_top + BLEND + l5 + l6 + l7 + l8
gsur s_front + BLEND + l1 + l10 - l5 - l9
gsur s_back + BLEND + l3 + l12 - l7 - l11
gsur s_fix + BLEND + l4 + l9 - l8 - l12
gsur s_tip + BLEND + l2 + l11 - l6 - l10

# 2. Mesh closed boundary skin with linear triangles (tr3)
elty all tr3
mesh all

# 3. Invoke TetGen to fill 3D volume with linear tetrahedra (te4 / C3D4)
mesh all tet

# 4. Export mesh to Abaqus format
send all abq

prnt se all

quit
