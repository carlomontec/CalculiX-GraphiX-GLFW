# ==============================================================================
# Test: 03_meshing_tetra_tetgen / test_tet10_notch_bracket.fbl
# Description: Notched structural specimen with notch grading meshed with te10
# ==============================================================================

# 1. Geometry Points (Waisted Notch Specimen)
pnt p1   0.0   0.0  0.0
pnt p2  50.0   5.0  0.0
pnt p3  50.0  25.0  0.0
pnt p4   0.0  30.0  0.0

pnt p5   0.0   0.0 10.0
pnt p6  50.0   5.0 10.0
pnt p7  50.0  25.0 10.0
pnt p8   0.0  30.0 10.0

# 2. Boundary Lines (Compact divisions for fast CI execution)
line l1 p1 p2 4
line l2 p2 p3 2
line l3 p3 p4 4
line l4 p4 p1 2

line l5 p5 p6 4
line l6 p6 p7 2
line l7 p7 p8 4
line l8 p8 p5 2

line l9  p1 p5 2
line l10 p2 p6 2
line l11 p3 p7 2
line l12 p4 p8 2

# 3. Apply Bias grading towards the notch neck
bia l1 2.0
bia l3 2.0
bia l5 2.0
bia l7 2.0

# 4. Construct Bounding Surfaces & Volume Body
gsur s_bot + BLEND + l1 + l2 + l3 + l4
gsur s_top + BLEND + l5 + l6 + l7 + l8
gsur s_front + BLEND + l1 + l10 - l5 - l9
gsur s_back + BLEND + l3 + l12 - l7 - l11
gsur s_fix + BLEND + l4 + l9 - l8 - l12
gsur s_tip + BLEND + l2 + l11 - l6 - l10

gbod b1 NORM + s_bot - s_top + s_front + s_back + s_fix + s_tip

# 5. Quadratic Tetrahedral Meshing (te10)
elty all te10
mesh all

# 6. Export Abaqus Mesh
send all abq

prnt se all

quit
