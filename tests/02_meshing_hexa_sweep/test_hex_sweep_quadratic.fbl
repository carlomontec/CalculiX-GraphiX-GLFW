# ==============================================================================
# Test: 02_meshing_hexa_sweep / test_hex_sweep_quadratic.fbl
# Description: Quadratic 20-node Hexahedral (he20 / C3D20) mesh via translational sweep
# ==============================================================================

# 1. 2D Base Surface at Z=0
pnt p1 0.0 0.0 0.0
pnt p2 15.0 0.0 0.0
pnt p3 15.0 15.0 0.0
pnt p4 0.0 15.0 0.0

line l1 p1 p2 6
line l2 p2 p3 6
line l3 p3 p4 6
line l4 p4 p1 6

gsur s1 + BLEND + l1 + l2 + l3 + l4

# 2. Put surface in set and sweep to create 3D Body
seta base s s1
swep base top tra 0.0 0.0 30.0 8 a

# 3. Set quadratic hexahedral element type (he20)
elty all he20
mesh all

# 4. Export mesh
send all abq

prnt se all

quit
