# ==============================================================================
# Test: 02_meshing_hexa_sweep / test_hex_sweep_linear.fbl
# Description: Linear 8-node Hexahedral (he8 / C3D8) mesh via translational sweep
# ==============================================================================

# 1. 2D Base Surface at Z=0
pnt p1 0.0 0.0 0.0
pnt p2 20.0 0.0 0.0
pnt p3 20.0 10.0 0.0
pnt p4 0.0 10.0 0.0

line l1 p1 p2 8
line l2 p2 p3 4
line l3 p3 p4 8
line l4 p4 p1 4

gsur s1 + BLEND + l1 + l2 + l3 + l4

# 2. Put surface into set and sweep to create 3D body
seta base s s1
swep base top tra 0.0 0.0 50.0 10 a

# 3. Set linear hexahedral element type (he8)
elty all he8
mesh all

# 4. Export mesh to Abaqus format
send all abq

# 5. Output entity check summary
prnt se all

quit
