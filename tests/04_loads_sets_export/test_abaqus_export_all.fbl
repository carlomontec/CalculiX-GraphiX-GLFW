# ==============================================================================
# Test: 04_loads_sets_export / test_abaqus_export_all.fbl
# Description: Validates export of Abaqus mesh (all.msh), SPCs (*.bou),
#              pressures (*.dlo), concentrated forces (*.frc), and sets (*.nam)
# ==============================================================================

# 1. Cantilever geometry (100 x 10 x 10)
pnt p1 0.0 0.0 0.0
pnt p2 100.0 0.0 0.0
pnt p3 100.0 10.0 0.0
pnt p4 0.0 10.0 0.0

pnt p5 0.0 0.0 10.0
pnt p6 100.0 0.0 10.0
pnt p7 100.0 10.0 10.0
pnt p8 0.0 10.0 10.0

line l1 p1 p2 10
line l2 p2 p3 2
line l3 p3 p4 10
line l4 p4 p1 2

line l5 p5 p6 10
line l6 p6 p7 2
line l7 p7 p8 10
line l8 p8 p5 2

line l9  p1 p5 2
line l10 p2 p6 2
line l11 p3 p7 2
line l12 p4 p8 2

gsur s_bot + BLEND + l1 + l2 + l3 + l4
gsur s_top + BLEND + l5 + l6 + l7 + l8
gsur s_front + BLEND + l1 + l10 - l5 - l9
gsur s_back + BLEND + l3 + l12 - l7 - l11
gsur s_fix + BLEND + l4 + l9 - l8 - l12
gsur s_tip + BLEND + l2 + l11 - l6 - l10

gbod b1 NORM + s_bot - s_top + s_front + s_back + s_fix + s_tip

# 2. Define Sets for BCs and Loads
seta fix s s_fix
seta tip s s_tip
seta top s s_top

# 3. Mesh with quadratic hex elements (he20)
elty all he20
mesh all

# 4. Generate Node Sets for constraints and loads
comp fix do
comp tip do
comp top do

# 5. Export mesh
send all abq

# 6. Export Boundary Conditions (SPCs: fixed 1,2,3)
send fix abq spc 123

# 7. Export Distributed Surface Pressure (e.g. 15.0 MPa on top)
send top abq pres 15.0

# 8. Export Concentrated Force on tip (Fz = -500 N)
send tip abq force 0.0 0.0 -500.0

# 9. Export Named Sets
send fix abq nam
send tip abq nam

quit
