# --------------------------------------------------------------------
# CalculiX GraphiX (GLFW Edition)
# File: Makefile.glfw - Cross-Platform Build for macOS, Linux, Windows
#
# Created by Carlo Monjaraz-Tec (2026) with AI pair-programming
# assistance based on the original work of Klaus Wittig & contributors.
# --------------------------------------------------------------------

UNAME_S := $(shell uname -s)

CC = gcc
CXX = g++

OPT ?= -O2
INCLUDES = -I./ -I../../libSNL/src -Itetgen
CFLAGS = $(OPT) -std=gnu17 -Wall -Wno-narrowing -DUSE_GLFW $(INCLUDES)
CXXFLAGS = $(OPT) -std=c++11 -Wall -Wno-narrowing -Wno-register -DTETLIBRARY -DUSE_GLFW $(INCLUDES)

ifeq ($(UNAME_S),Darwin)
  # macOS native configuration (Zero X11 / Zero XQuartz / Zero GLUT)
  GLFW_CFLAGS := $(shell pkg-config --cflags glfw3 2>/dev/null || echo "-I/opt/homebrew/include -I/usr/local/include")
  ifeq ($(STATIC_GLFW),1)
    GLFW_STATIC_LIB := $(shell pkg-config --variable=libdir glfw3 2>/dev/null)/libglfw3.a
    ifeq ($(wildcard $(GLFW_STATIC_LIB)),)
      GLFW_STATIC_LIB := $(shell brew --prefix glfw 2>/dev/null)/lib/libglfw3.a
    endif
    ifeq ($(wildcard $(GLFW_STATIC_LIB)),)
      GLFW_STATIC_LIB := /opt/homebrew/lib/libglfw3.a
    endif
    GLFW_LIBS := $(GLFW_STATIC_LIB)
  else
    GLFW_LIBS := $(shell pkg-config --libs glfw3 2>/dev/null || echo "-L/opt/homebrew/lib -L/usr/local/lib -lglfw")
  endif
  INCLUDES += $(GLFW_CFLAGS)
  CFLAGS += $(GLFW_CFLAGS)
  CXXFLAGS += $(GLFW_CFLAGS)
  LFLAGS = $(GLFW_LIBS) \
           -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo -framework QuartzCore \
           -lm -lpthread
else ifneq ($(findstring MINGW,$(UNAME_S))$(findstring MSYS,$(UNAME_S))$(findstring CYGWIN,$(UNAME_S))$(findstring Windows,$(OS)),)
  # Windows MinGW-w64 / MSYS2 configuration
  CFLAGS += -DWIN32 $(shell pkg-config --cflags glfw3 2>/dev/null)
  CXXFLAGS += -DWIN32 $(shell pkg-config --cflags glfw3 2>/dev/null)
  LFLAGS = $(shell pkg-config --libs glfw3 2>/dev/null || echo "-lglfw3") -lopengl32 -lglu32 -lgdi32 -luser32 -lkernel32 -lm \
          -static-libgcc -static-libstdc++ -static -lpthread
  OUT = ../../../bin/cgx_glfw.exe
else
  # Linux configuration (Native Wayland & X11 via GLFW)
  ifneq ($(wildcard /home/linuxbrew/.linuxbrew/include/GLFW/glfw3.h),)
    CFLAGS += -I/home/linuxbrew/.linuxbrew/include
    CXXFLAGS += -I/home/linuxbrew/.linuxbrew/include
    LFLAGS = -L/home/linuxbrew/.linuxbrew/lib -lglfw -lGL -lGLU -lm -lpthread -ldl
  else ifneq ($(wildcard $(HOME)/.linuxbrew/include/GLFW/glfw3.h),)
    CFLAGS += -I$(HOME)/.linuxbrew/include
    CXXFLAGS += -I$(HOME)/.linuxbrew/include
    LFLAGS = -L$(HOME)/.linuxbrew/lib -lglfw -lGL -lGLU -lm -lpthread -ldl
  else
    CFLAGS += $(shell pkg-config --cflags glfw3 2>/dev/null)
    CXXFLAGS += $(shell pkg-config --cflags glfw3 2>/dev/null)
    LFLAGS = $(shell pkg-config --libs glfw3 2>/dev/null || echo "-lglfw") -lGL -lGLU -lm -lpthread -ldl
  endif
endif

include Makefile.inc

ULIB = \
 userFunction.c

GLFW_LIB = \
 cgx_glut_glfw.c \
 cgx_iosevka_font.c

CPP_SRC = \
 uselibSNL.cpp \
 generateTet.cpp \
 tetgen/tetgen.cxx \
 tetgen/predicates.cxx \
 $(wildcard ../../libSNL/src/*.cpp)

OUT ?= ../../bin/cgx_glfw

SRCS = $(SLIB) $(ULIB) $(GLFW_LIB)
OBJS = $(SRCS:.c=.o)
CPP_OBJS = $(patsubst %.cpp,%.o,$(patsubst %.cxx,%.o,$(CPP_SRC)))

all: $(OUT)

$(OUT): $(OBJS) $(CPP_OBJS)
	@mkdir -p $(dir $(OUT))
	$(CXX) $(CXXFLAGS) $(OBJS) $(CPP_OBJS) -o $(OUT) $(LFLAGS)
	@mkdir -p ../../../bin && cp -f $(OUT) ../../../bin/cgx_glfw 2>/dev/null || true
	@echo ">>> SUCCESS: Built $(OUT) <<<"

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

%.o: %.cxx
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(CPP_OBJS) $(OUT) tetgen/*.o
